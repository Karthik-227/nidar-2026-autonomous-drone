diff --git a/ardupilot_gz_bringup/config/alti_transition_bridge.yaml b/ardupilot_gz_bringup/config/alti_transition_bridge.yaml
index abddb67..a3981ca 100644
--- a/ardupilot_gz_bringup/config/alti_transition_bridge.yaml
+++ b/ardupilot_gz_bringup/config/alti_transition_bridge.yaml
@@ -1,6 +1,13 @@
 ---
+# NIDAR patch: was gz_topic_name "/clock", which has NO PUBLISHER in Gazebo
+# Harmonic - `gz topic -i -t /clock` reports subscribers only. The world-scoped
+# topic is the one that actually publishes. With the bridge pointed at the dead
+# topic, ROS /clock never received a message, so every node launched with
+# use_sim_time:=true sat at t=0 forever: ROS timers never fired, Nav2's costmaps
+# never updated, and nodes looked hung with no error. Verified: bridging
+# /world/<world>/clock gives /clock at ~1000 Hz.
 - ros_topic_name: "clock"
-  gz_topic_name: "/clock"
+  gz_topic_name: "/world/{{ world_name }}/clock"
   ros_type_name: "rosgraph_msgs/msg/Clock"
   gz_type_name: "gz.msgs.Clock"
   direction: GZ_TO_ROS
